# @labforge/api environment (copy to .env, git-ignored)

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Single host, path-based routing
LAB_DOMAIN=labs.gurnoor.online

# Postgres
DATABASE_URL=postgres://labforge:labforge@localhost:5432/labforge

# Session signing (generate a random value; do NOT commit the real one)
SESSION_SECRET=change-me-32-bytes-min

# Google OIDC (Phase 3). Real values come from a K8s Secret in prod.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://labs.gurnoor.online/auth/callback

# Dev-only fake auth (Phase 2). Must be false in prod.
DEV_FAKE_AUTH=true

# Lab limits
LAB_TTL=45m
POOL_SIZE=3
MAX_CONCURRENT_LABS=10
