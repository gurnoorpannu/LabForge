# @labforge/api environment. Copy to services/api/.env (git-ignored).
# Every variable is validated at startup (services/shared/src/config.ts); defaults shown.

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Base URL users open labs on (local k3d ingress is mapped to :8080)
PUBLIC_BASE_URL=http://localhost:8080
# INGRESS_HOST=labs.gurnoor.online   # prod only; unset locally = match any host
# INGRESS_CLASS=traefik
# INGRESS_NAMESPACE=kube-system      # where Traefik runs (k3s default)

# `make dev-db` starts this Postgres in Docker
DATABASE_URL=postgres://labforge:labforge@localhost:5432/labforge

LAB_IMAGE=labforge-lab:dev
LAB_IMAGE_PULL_POLICY=IfNotPresent
LAB_TTL=45m
LAB_READY_TIMEOUT=60s
POOL_SIZE=3
MAX_CONCURRENT_LABS=10

# Per-lab resources
# LAB_CPU_REQUEST=250m
# LAB_CPU_LIMIT=500m
# LAB_MEMORY_REQUEST=256Mi
# LAB_MEMORY_LIMIT=512Mi

# Network isolation (k3s defaults)
LAB_INTERNET_EGRESS=true
# REQUIRED. Node network, blocked from labs: the API server's ClusterIP is
# rewritten to a node IP before NetworkPolicy is evaluated. Local: the subnet
# `make dev-up` pins for k3d. Prod: the OCI VCN subnet.
NODE_CIDR=172.28.0.0/16
# POD_CIDR=10.42.0.0/16
# SERVICE_CIDR=10.43.0.0/16
# METADATA_CIDR=169.254.169.254/32

# Phase 2 only: trust an `x-dev-user` header. Refused when NODE_ENV=production.
DEV_FAKE_AUTH=true
RATE_LIMIT_PER_MIN=5

# Phase 3 (not read yet): Google OIDC + sessions. Real values live in a K8s Secret.
# SESSION_SECRET=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
